# This repository holds the thesis and the conference paper for Overleaf. Keep the complete local
# research workspace excluded in clones too, without relying on .git/info/exclude.
/RESOURCES.md
/research/
/context/
/archive/
/docs/
/scripts/

# Private case-level evidence at any depth (keep locally, never in manuscript ZIPs).
private/

# Credentials and newly copied private spreadsheet inputs.
.env
.env.*
auth.json
credentials.json
credentials.*.json
secrets.json
secrets.*.json
posthog.txt
id_rsa
id_ed25519
*.pem
*.key
*.p12
*.pfx
*.xlsx
*.xlsm
*.xls
*.xltx

# LaTeX temporary files; retain source figures, including intentional PDFs.
*.aux
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.run.xml
*.synctex.gz
*.xdv
*.out
*.toc
*.lof
*.lot
*.bbl
*.nav
*.snm
*.vrb

# Machine-local tooling and disposable Python/editor caches.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.codegraph/
torchinductor_*/
.local-artifacts/
.DS_Store
Thumbs.db
Desktop.ini
*.bak
*.swp
*.swo
*~
/debug.log
/%SystemDrive%/

# The manuscript source is maintained; compiler/build products remain local.
/thesis/build/
/thesis/cache/
/thesis/*.zip
/paper/build/
/paper/cache/
/paper/*.zip
# Historical tables retained for local verification; not active manuscript inputs.
/paper/answer_results.tex
/paper/results.tex
/paper/retrieval_results.tex
# Shared local compiler: keep the configuration, ignore the binary and cache.
/tools/*
!/tools/fonts.conf
!/tools/README.md
!/tools/runtime-manifest.json
